NOIR_DATA_DIR=/var/lib/noir/data
NOIR_APKTOOL_JAR=/opt/noir/tools/apktool_3.0.3.jar
NOIR_ANDROID_SDK_DIR=/opt/noir/android-sdk
ANDROID_HOME=/opt/noir/android-sdk
JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64
NOIR_JAVA_EXECUTABLE=/opt/noir/deployment/java-wrapper
NOIR_BUILD_TOOLS_VERSION=36.0.0
NOIR_AI_PROVIDER=gemini
NOIR_AI_MODEL=gemini-3.6-flash
NOIR_AI_FALLBACK_MODEL=
NOIR_AI_TIMEOUT=120
NOIR_AI_MAX_REQUEST_SIZE=100000
NOIR_AI_MAX_OUTPUT_SIZE=50000
NOIR_API_HOST=127.0.0.1
NOIR_API_PORT=8787
