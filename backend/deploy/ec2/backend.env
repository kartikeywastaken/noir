NOIR_DATA_DIR=/var/lib/noir/data
NOIR_APKTOOL_JAR=/opt/noir/tools/apktool_3.0.3.jar
NOIR_ANDROID_SDK_DIR=/opt/noir/android-sdk
ANDROID_HOME=/opt/noir/android-sdk
JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64
NOIR_JAVA_EXECUTABLE=/opt/noir/deployment/java-wrapper
NOIR_DOTNET_TOOL_PATH=/usr/bin/dotnet
NOIR_CIL_TOOL_PATH=/opt/noir/tools/noir-cil-tool/bin/Release/net8.0/noir-cil-tool.dll
NOIR_BUILD_TOOLS_VERSION=36.0.0
NOIR_AI_PROVIDER=adk
NOIR_AI_MODEL=gemini-3.6-flash
# AI credentials are supplied only through encrypted systemd credentials.
NOIR_AI_FALLBACK_MODEL=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-flash-latest,gemini-3.1-pro-preview
NOIR_DISCOVERY_PROVIDER=adk
NOIR_OPENROUTER_DISCOVERY_MODEL=minimax/minimax-m3:free
NOIR_OPENROUTER_DISCOVERY_FALLBACK_MODEL=z-ai/glm-5.2:free
NOIR_AI_STALL_TIMEOUT=60
NOIR_AI_TIMEOUT=90
NOIR_AI_MAX_REQUEST_SIZE=400000
NOIR_AI_MAX_OUTPUT_SIZE=65000
NOIR_AI_MAX_OUTPUT_TOKENS=4096
NOIR_DISCOVERY_MAX_ROUNDS=3
NOIR_DISCOVERY_TIMEOUT=30
NOIR_API_HOST=127.0.0.1
NOIR_API_PORT=8787
NOIR_UPLOAD_CHUNK_SIZE=2097152
NOIR_MAX_UPLOAD_CHUNK_SIZE=16777216
NOIR_UPLOAD_SESSION_TTL=86400
NOIR_ARTIFACT_STORE=s3
NOIR_S3_BUCKET=noir-private-artifacts-865675170355-eu-north-1
NOIR_S3_REGION=eu-north-1
NOIR_S3_PREFIX=noir
NOIR_S3_PRESIGN_EXPIRY=900
NOIR_S3_UPLOAD_PART_SIZE=8388608
