[Unit]
Description=NOIR invite-only APK backend
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=noir
Group=noir
WorkingDirectory=/opt/noir/backend
EnvironmentFile=/etc/noir/backend.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=HOME=/var/lib/noir
Environment=PATH=/opt/noir/venv/bin:/opt/noir/android-sdk/build-tools/36.0.0:/usr/lib/jvm/java-21-openjdk-amd64/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
LoadCredentialEncrypted=gemini-discovery-api-key:/etc/credstore.encrypted/noir-gemini-discovery-api-key
LoadCredentialEncrypted=gemini-generation-api-key:/etc/credstore.encrypted/noir-gemini-generation-api-key
LoadCredentialEncrypted=openrouter-api-key:/etc/credstore.encrypted/noir-openrouter-api-key
LoadCredentialEncrypted=signing-password:/etc/credstore.encrypted/noir-signing-password
LoadCredentialEncrypted=api-token:/etc/credstore.encrypted/noir-api-token
ExecStart=/opt/noir/venv/bin/python /opt/noir/deployment/service.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/noir
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
TasksMax=256
MemoryHigh=3G
MemoryMax=3400M

[Install]
WantedBy=multi-user.target
