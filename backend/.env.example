# Copy to backend/.env. Existing environment variables override this file.
# NOIR loads backend/.env automatically, independent of your current directory.
GEMINI_API_KEY=
NOIR_AI_PROVIDER=gemini
NOIR_AI_MODEL=gemini-3.6-flash
NOIR_AI_FALLBACK_MODEL=
# Optional AI output limits. Response retries are additional billable generations.
# NOIR_AI_MAX_OUTPUT_TOKENS=16384
# NOIR_AI_RESPONSE_RETRY_LIMIT=1
# NOIR_AI_MAX_OUTPUT_SIZE=50000

# Optional overrides. Use absolute paths.
# NOIR_DATA_DIR=/absolute/path/to/noir-data
# NOIR_ANDROID_SDK_DIR=/Users/you/Library/Android/sdk
# NOIR_BUILD_TOOLS_VERSION=36.0.0
# NOIR_APKTOOL_PATH=/opt/homebrew/bin/apktool
# NOIR_APKTOOL_JAR=/absolute/path/to/apktool.jar
# NOIR_DOTNET_TOOL_PATH=/absolute/path/to/dotnet
# NOIR_CIL_TOOL_PATH=/absolute/path/to/noir-cil-tool.dll
# NOIR_MAX_ASSEMBLY_SIZE=15728640
# NOIR_MAX_NATIVE_LIBRARY_SIZE=134217728
# NOIR_MAX_IL2CPP_METADATA_SIZE=67108864
# NOIR_PROCESS_TIMEOUT=300
# NOIR_UPLOAD_CHUNK_SIZE=262144
# NOIR_MAX_UPLOAD_CHUNK_SIZE=1048576
# NOIR_UPLOAD_SESSION_TTL=86400

# Java subprocess environment belongs in your terminal, NOT this file:
# export JAVA_HOME=/opt/homebrew/opt/openjdk@21
# export PATH="$JAVA_HOME/bin:/opt/homebrew/bin:$PATH"

# Signing passwords are stored in the OS credential store, not this file.
# For a user keystore, NOIR_KEYSTORE_PASSWORD / NOIR_KEY_PASSWORD can instead
# be supplied in the process environment. Never put passwords in command args.
# Durable artifacts (decoded workspaces remain on local EBS)
NOIR_ARTIFACT_STORE=local
NOIR_S3_BUCKET=
NOIR_S3_REGION=
NOIR_S3_PREFIX=noir
NOIR_S3_PRESIGN_EXPIRY=900
